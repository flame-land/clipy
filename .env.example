# Required: keep your real token only in your local .env file.
DISCORD_TOKEN=put_your_bot_token_here

# Optional: server ID for faster development slash-command sync; leave blank for global sync.
DEV_GUILD_ID=

# Prefix commands: !clip search goku black OR @Clipy clip search goku black
BOT_PREFIX=!

# Presence status: online, idle, dnd, invisible
# "mobile" is not a supported bot status.
BOT_STATUS=online

# Activity type: playing, listening, watching, competing, streaming
BOT_ACTIVITY_TYPE=listening

# Rotate through these activity messages in order, separated by |.
# Set BOT_ACTIVITY_INTERVAL to the seconds between messages (minimum 15).
BOT_ACTIVITY_MESSAGES=/clip search|anime clips|!help
BOT_ACTIVITY_INTERVAL=30

# Fallback used if BOT_ACTIVITY_MESSAGES is empty.
BOT_ACTIVITY_NAME=/clip search

# Required only for streaming activity; use a Twitch or YouTube URL.
BOT_STREAM_URL=

# Public URL of the BGremover green-screen website.
BGREMOVER_URL=
